# Hoist ONLY Metro packages to the root: @expo/cli requires them without
# declaring them (Cannot find module 'metro-core'). Everything else stays
# isolated so each app resolves its own React — a fully hoisted layout made
# styled-jsx grab mobile's React 19 during Next prerender (useContext null on
# /404 and /500 in the Vercel build).
public-hoist-pattern[]=*metro*

{
  "expo": {
    "name": "Quirks & All",
    "slug": "quirks-and-all",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "quirksandall",
      "rc-358cffb44f",
      "rc-961b7cef65"
    ],
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E5BEC4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.itshypothetical.quirksandall",
      "buildNumber": "26",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a photo of your pet, or a document like a vaccination record.",
        "NSCameraUsageDescription": "Take a photo of your pet, or a document like a vaccination record.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#510000"
      },
      "package": "com.itshypothetical.quirksandall"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#510000"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "its-hypothetical",
          "project": "quirks"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64d7579d-1a5e-43a7-995a-5a8bf7718b21"
      }
    }
  }
}

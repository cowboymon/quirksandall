EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_WEB_URL=https://app.quirksandall.itshypothetical.com

# RevenueCat — set the platform-specific keys for production (appl_… / goog_…),
# or a single shared key (e.g. a test-store key) via EXPO_PUBLIC_RC_KEY.
EXPO_PUBLIC_RC_IOS_KEY=your-revenuecat-ios-key
EXPO_PUBLIC_RC_ANDROID_KEY=your-revenuecat-android-key
EXPO_PUBLIC_RC_KEY=your-revenuecat-test-store-key

# Mixpanel — public project token for product analytics. Analytics is a safe
# no-op if this is unset.
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-project-token

# Google Places — vet-clinic address autocomplete. Optional.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=your-google-places-key

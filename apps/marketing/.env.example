# Supabase — required for the launch waitlist API route (app/api/waitlist).
# Same project as the app; the service-role key is server-only (never exposed
# to the browser). Set these in Vercel → Project → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

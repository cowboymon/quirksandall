# Supabase — required for the launch waitlist API route (app/api/waitlist).
# Same project as the app. Both are read at runtime, server-side only.
# Set these in Vercel → Project → Environment Variables (Production), then
# redeploy. Use a plain SUPABASE_URL (not NEXT_PUBLIC_) so the value isn't
# inlined at build time.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Also accepted as fallbacks if you already have them:
#   NEXT_PUBLIC_SUPABASE_URL  (works, but inlined at build time)
#   SUPABASE_SERVICE_ROLE_KEY

# Admin (/admin, /api/admin/*) — HTTP Basic Auth. Required to reach the
# admin dashboard at all (middleware.ts fails closed with no ADMIN_PASSWORD).
ADMIN_PASSWORD=your-admin-password
ADMIN_USER=admin

# Anthropic — optional. Used only for best-effort AI theming of roadmap
# suggestions (app/lib/classify.ts). Unset = suggestions save untagged,
# nothing else breaks.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Public — safe to expose in the browser bundle (NEXT_PUBLIC_ vars are
# inlined at build time by design).
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

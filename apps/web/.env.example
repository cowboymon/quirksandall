NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional — dedicated signing secret for the persisted PIN-unlock cookie.
# Falls back to SUPABASE_SERVICE_KEY if unset, so nothing breaks without it.
PIN_UNLOCK_SECRET=your-pin-unlock-signing-secret

# Optional — public Mixpanel project token for the recipient page's
# anonymous view-tracking. Analytics is a safe no-op if unset.
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-project-token
